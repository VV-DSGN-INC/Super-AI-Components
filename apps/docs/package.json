{
  "name": "docs",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm run build:registry && next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:tokens": "node ../../packages/ds-rules/rulecheck.mjs --severity blocker",
    "check:contract": "tsx scripts/check-contract.mts && tsx scripts/check-citations.mts && tsx scripts/reconcile-deps.mts",
    "a11y:baseline": "tsx scripts/a11y-baseline.mts",
    "story-coverage:baseline": "tsx scripts/story-coverage-baseline.mts",
    "story-coverage:report": "tsx scripts/story-coverage-report.mts",
    "contract:emit": "CONTRACT_EMIT=1 vitest run scripts/lib/contract-emit.test.ts",
    "facts:emit": "FACTS_EMIT=1 vitest run scripts/lib/system-facts.test.ts",
    "contract-coverage:baseline": "tsx scripts/contract-coverage-baseline.mts",
    "gen:wiring": "tsx scripts/gen-wiring.mts",
    "new:component": "tsx scripts/new-component.mts",
    "reconcile:deps": "tsx scripts/reconcile-deps.mts",
    "prod:diff": "tsx scripts/prod-diff.mts",
    "build:registry": "tsx scripts/gen-wiring.mts && tsx scripts/gen-registry.mts && shadcn build --output public/r"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "ai": "^7.0.112",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.47.0",
    "motion": "^12.42.0",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-resizable-panels": "^4.13.2",
    "recharts": "3.10.1",
    "shadcn": "^4.21.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.2.0",
    "dom-accessibility-api": "^0.7.1",
    "ds-rules": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "js-yaml": "4.2.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^4.1.8"
  }
}
