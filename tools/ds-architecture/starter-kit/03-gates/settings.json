{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PROJECT_DIR}/scripts/rulecheck.mjs --files \"$CLAUDE_FILE_PATHS\" --severity blocker || true"
          }
        ]
      }
    ]
  }
}
